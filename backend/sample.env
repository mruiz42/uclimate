# Copy to .env and adjust as needed. No API keys are required.

# Upstream services (public instances by default; self-host for heavy use)
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_URL=https://api.open-meteo.com

# Distance between the points checked for hazards along a route, in kilometres
TRACK_INTERVAL_KM=10
# Upper bound on those points (the spacing widens on long routes)
MAX_TRACK_POINTS=200
# Upper bound on stops listed per trip (the user's interval widens on long routes)
MAX_STOPS=40

# Comma-separated origins allowed to call the API directly from a browser.
# Leave empty for local dev: the Vite dev server proxies /api.
CORS_ORIGINS=
